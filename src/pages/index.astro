---
import SiteLayout from "../layouts/SiteLayout.astro";
import { appStoreBadgeLink, engineHoursGuidePath, maintenanceChecklistPath, maintenanceLogPath, serviceCalculatorPath } from "../site";
import "../styles/resources.css";
---
<SiteLayout route="/">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Available on iOS
      </div>
      <h1 class="hero-title">
        Dirt Bike<br><span class="accent">Maintenance Tracker</span>
      </h1>
      <p class="hero-text">
        Log rides, track engine hours, and see what service is due for every bike in your garage.
      </p>
      <div class="hero-actions">
        <a href={appStoreBadgeLink} class="btn-app-store" target="_blank" rel="noopener" aria-label="Download DIRTTIME on the App Store" data-app-store>
          <svg class="btn-app-store__logo" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
          </svg>
          <span class="btn-app-store__text">
            <span class="btn-app-store__eyebrow">Download on the</span>
            <span class="btn-app-store__wordmark">App Store</span>
          </span>
        </a>
        <a href="#features" class="btn btn-secondary">
          Learn More
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- iPhone Mockup -->
    <div class="hero-phones">
      <div class="iphone-stack">
        <!-- Background phones -->
        <div class="iphone iphone-back-left">
          <div class="iphone-screen">
            <img src="/images/screenshots/photo_2026-01-21_16-05-50.jpg" alt="Bike details view" width="589" height="1280" decoding="async">
          </div>
        </div>
        <div class="iphone iphone-back-right">
          <div class="iphone-screen">
            <img src="/images/screenshots/photo_2026-01-21_16-05-47.jpg" alt="Activity log" width="589" height="1280" decoding="async">
          </div>
        </div>
        <!-- Main phone -->
        <div class="iphone iphone-main">
          <div class="iphone-notch"></div>
          <div class="iphone-screen">
            <img src="/images/screenshots/photo_2026-01-21_16-05-55.jpg" alt="DIRTTIME Garage" fetchpriority="high" width="589" height="1280" decoding="async">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section">
    <div class="container">
      <header class="section-header">
        <span class="section-label">Features</span>
        <h2 class="section-title">Everything You Need</h2>
        <p class="section-text">Built for riders who care about their machines</p>
      </header>

      <div class="features-grid">
        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
            </svg>
          </div>
          <h3>Track Hours &amp; Mileage</h3>
          <p>Log every ride with automatic service calculations.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <h3>Smart Scheduling</h3>
          <p>Flexible intervals by hours, distance, or days.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h3>Service Alerts</h3>
          <p>Get notified before maintenance is overdue.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Terrain Profiles</h3>
          <p>Adjusted intervals for racing, sand, or mud.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <h3>Service History</h3>
          <p>Complete log of every maintenance performed.</p>
        </article>

        <article class="feature-card">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>
            </svg>
          </div>
          <h3>Home Widgets</h3>
          <p>Check status right from your home screen.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- App Preview -->
  <section class="section showcase">
    <div class="container">
      <header class="section-header">
        <span class="section-label">Preview</span>
        <h2 class="section-title">See It In Action</h2>
      </header>
    </div>
    <div class="screenshots-track">
      <div class="screenshots-slider">
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-1.jpg" alt="DIRTTIME Garage" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-2.jpg" alt="Bike Details" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-3.jpg" alt="Maintenance Tasks" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-4.jpg" alt="Add Ride" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-5.jpg" alt="Service History" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-6.jpg" alt="Ride Log" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-7.jpg" alt="Settings" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-8.jpg" alt="Widgets" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-9.jpg" alt="Notifications" width="400" height="869" loading="lazy"></div>
        <div class="screenshot"><img src="/images/appstorescreensots_2.9.0/slice-10.jpg" alt="Profile" width="400" height="869" loading="lazy"></div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section steps">
    <div class="container">
      <header class="section-header">
        <span class="section-label">Getting Started</span>
        <h2 class="section-title">How It Works</h2>
      </header>

      <div class="steps-grid">
        <article class="step-card">
          <span class="step-number">1</span>
          <h3>Add Your Bikes</h3>
          <p>Enter bike details with current hours and mileage.</p>
        </article>
        <article class="step-card">
          <span class="step-number">2</span>
          <h3>Set Maintenance</h3>
          <p>Configure tasks with your preferred intervals.</p>
        </article>
        <article class="step-card">
          <span class="step-number">3</span>
          <h3>Log &amp; Ride</h3>
          <p>Log rides and get alerts when service is due.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="resources-title">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title" id="resources-title">Dirt Bike Maintenance Resources</h2>
      </header>
      <div class="resource-grid">
        <article class="resource-card">
          <h3>Maintenance Log</h3>
          <p>Keep a record of service, parts, and engine hours. Start with a printable sheet or a CSV for your spreadsheet.</p>
          <a class="btn btn-secondary" href={maintenanceLogPath}>Get the Maintenance Log</a>
        </article>
        <article class="resource-card">
          <h3>Service Interval Calculator</h3>
          <p>Enter your meter readings and service interval to see what’s due and how much riding time or distance remains.</p>
          <a class="btn btn-secondary" href={serviceCalculatorPath}>Use the Service Calculator</a>
        </article>
        <article class="resource-card">
          <h3>Engine Hours vs. Mileage</h3>
          <p>Know which reading to record for each service, and use your owner’s manual to work out when the job is due.</p>
          <a class="btn btn-secondary" href={engineHoursGuidePath}>Read the Guide</a>
        </article>
        <article class="resource-card">
          <h3>Maintenance Checklist</h3>
          <p>Use a one-page checklist for pre-ride checks, post-ride upkeep, and work due on your service schedule.</p>
          <a class="btn btn-secondary" href={maintenanceChecklistPath}>Get the Checklist</a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta">
    <div class="container">
      <div class="cta-content">
        <h2 class="cta-title">Ready to Ride Smarter?</h2>
        <p class="cta-text">Available as a paid app on iPhone and iPad. See the App Store for local pricing.</p>
        <a href={appStoreBadgeLink} class="btn-app-store" target="_blank" rel="noopener" aria-label="Download DIRTTIME on the App Store" data-app-store>
          <svg class="btn-app-store__logo" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
          </svg>
          <span class="btn-app-store__text">
            <span class="btn-app-store__eyebrow">Download on the</span>
            <span class="btn-app-store__wordmark">App Store</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
