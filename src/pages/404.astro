---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout>
  <section class="page-header">
    <div class="container">
      <h1>Page Not Found</h1>
      <p class="subtitle">This address doesn’t lead to a DIRTTIME page.</p>
    </div>
  </section>
  <section class="page-content" aria-label="Where to go next">
    <div class="container">
      <div class="content-card">
        <p>Visit the homepage for app information or open Support for help.</p>
        <p><a class="btn btn-primary" href="/">Back to Home</a></p>
        <p><a href="/support/">Go to Support</a></p>
      </div>
    </div>
  </section>
</SiteLayout>
