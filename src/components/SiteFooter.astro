---
import { appStoreLink } from "../site";
---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/images/icon.png" alt="" width="28" height="28">
          <span>DIRTTIME</span>
        </a>
        <p class="footer-tagline">Track. Maintain. Ride.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <div class="footer-col">
          <h4>Product</h4>
          <a href="/#features">Features</a>
          <a href={appStoreLink} target="_blank" rel="noopener" data-app-store>Download</a>
        </div>
        <div class="footer-col">
          <h4>Support</h4>
          <a href="/support/">Help Center</a>
          <a href="/feedback/">Feedback</a>
        </div>
        <div class="footer-col">
          <h4>Legal</h4>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
        </div>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2025–{new Date().getUTCFullYear()} DIRTTIME. All rights reserved.</p>
      <p>For iPhone and iPad</p>
    </div>
  </div>
</footer>
