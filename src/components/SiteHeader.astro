---
import { appStoreLink } from "../site";

const { currentPath } = Astro.props;
---
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">
      <img src="/images/icon.png" alt="" width="36" height="36">
      <span>DIRTTIME</span>
    </a>

    <nav class="nav-center" aria-label="Main">
      <a href="/support/" aria-current={currentPath === "/support/" ? "page" : undefined}>Support</a>
      <a href="/feedback/" aria-current={currentPath === "/feedback/" ? "page" : undefined}>Feedback</a>
      <a href="/privacy/" aria-current={currentPath === "/privacy/" ? "page" : undefined}>Privacy</a>
      <a href="/terms/" aria-current={currentPath === "/terms/" ? "page" : undefined}>Terms</a>
    </nav>

    <a href={appStoreLink} class="nav-cta" target="_blank" rel="noopener" data-app-store>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
      </svg>
      App Store
    </a>

    <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" aria-hidden="true">
    <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Home</a>
    <a href="/support/" aria-current={currentPath === "/support/" ? "page" : undefined}>Support</a>
    <a href="/feedback/" aria-current={currentPath === "/feedback/" ? "page" : undefined}>Feedback</a>
    <a href="/privacy/" aria-current={currentPath === "/privacy/" ? "page" : undefined}>Privacy</a>
    <a href="/terms/" aria-current={currentPath === "/terms/" ? "page" : undefined}>Terms</a>
    <a href={appStoreLink} class="mobile-cta" target="_blank" rel="noopener" data-app-store>Download App</a>
  </nav>
</header>
