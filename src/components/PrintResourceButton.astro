---
interface Props {
  label: string;
  primary?: boolean;
}

const { label, primary = false } = Astro.props;
---
<button class:list={["btn", primary ? "btn-primary" : "btn-secondary"]} type="button" data-print-resource hidden>
  {label}
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-print-resource]")) {
    button.addEventListener("click", () => window.print());
    button.hidden = false;
  }
</script>
