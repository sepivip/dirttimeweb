---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { appStoreUrl, pages, type Route } from "../site";

interface Props {
  route?: Route;
  measureAppStoreClicks?: boolean;
}

const { route, measureAppStoreClicks = true } = Astro.props;
const { title, description } = route ? pages[route] : {
  title: "Page Not Found | DIRTTIME",
  description: "Find the DIRTTIME homepage or get help with the app.",
};
const canonical = route ? new URL(route, Astro.site).href : undefined;
const shareImage = new URL("/images/og.png", Astro.site).href;
const isHome = route === "/";
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "DIRTTIME",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "iOS, iPadOS",
  description,
  url: canonical,
  downloadUrl: appStoreUrl,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#050505">
    {canonical ? <link rel="canonical" href={canonical}> : <meta name="robots" content="noindex">}

    <meta property="og:type" content="website">
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={shareImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="DIRTTIME">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={shareImage}>

    {isHome && <meta name="apple-itunes-app" content="app-id=6752694574">}
    {isHome && <meta name="google-site-verification" content="-BoAMAVOWhKif2CDNoRW1GZ32X9ZxjPK0tdIhQkCKIU">}
    {isHome && <meta name="msvalidate.01" content="07AECDEA857824A0D0779C187FCBE0D1">}
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="DIRTTIME">
    <link rel="icon" type="image/png" href="/images/icon.png">
    <link rel="apple-touch-icon" href="/images/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">

    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />}
    {isHome && <script is:inline src="/legacy-links.js"></script>}
    <script is:inline src="/main.js" data-site-measurement={measureAppStoreClicks ? "enabled" : "disabled"} defer></script>
    <noscript>
      <style is:inline>
        @media (max-width: 768px) {
          .header .nav-toggle { display: none; }
          .header .nav-cta { display: inline-flex; }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <canvas id="webgl-canvas" aria-hidden="true"></canvas>
    <div class="grain-overlay" aria-hidden="true"></div>
    <SiteHeader currentPath={route} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
